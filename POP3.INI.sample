; POP3.INI  -  settings for the UMLMM gateway (sending and receiving)
; Save a copy of this file as POP3.INI in the same folder as MAILRUN.LOG
; (normally C:\MSBOB\MAILROOM).  Lines starting with ; are comments.

[SERVER]
SmtpHost=msbob.org
SmtpPort=25
; Name the gateway announces to the server (EHLO).
Hello=localhost

Pop3Host=msbob.org
Pop3Port=110

; RECEIVING: the individual IDs (from the [USERS] list in MAILROOM.INI) whose
; mailboxes are checked on every mail run, separated by commas.  Every ID
; listed here needs a [USER.<id>] section below.
Users=218-0241

; 1 = delete each message from the server after it has been downloaded
; (default).  With 0 the same mail is downloaded again on every run.
Delete=1

; 1 = also keep an untouched copy of every downloaded message as
; <name>.EML in the MAILROOM folder (default; a safety net while testing).
KeepRaw=1

; Maximum number of messages downloaded per mail run (0 = no limit).  Keeps a
; run short; whatever is left on the server is fetched on the next run.
MaxPerRun=25

; 0 = oldest message first (normal).  1 = newest first: useful while testing
; a mailbox with a large backlog, so a brand-new test message comes first.
NewestFirst=0

; 1 = show the other To: and Cc: recipients of incoming mail in Bob
; (default).  0 = show only the Bob user.
ShowRecipients=1

; How the Date: line of incoming mail is written for Bob.
;   none = no Date line (try this first)
;   mci  = "Wed Nov 04, 2026  03:20 am GMT"
;   rfc  = the original Internet date, unchanged
DateStyle=mci

; Only if the transport does not pass the IN folder itself:
;InDir=C:\MSBOB\MAILROOM\IN

; One section per Bob user.  The section name is USER. followed by the
; user's individual ID.
[USER.218-0241]
; Address used as the sender (MAIL FROM and the From: header).
Email=marisa@msbob.org
; Login for the server (used for sending and for receiving).
User=marisa
Password=changeme
; The name Bob should show as the recipient of incoming mail.
FullName=Marisa Giancarla
; Only if sending and receiving need different logins:
;SmtpUser=
;SmtpPassword=
;PopUser=
;PopPassword=

; Add another section for each additional user, and add their ID to Users=
;[USER.218-0243]
;Email=second@msbob.org
;User=second
;Password=changeme
;FullName=Second Person
